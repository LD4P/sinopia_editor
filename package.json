{
  "name": "sinopia_editor",
  "description": "Editor for BIBFRAME data forked from http://github.com/lcnetdev/bfe",
  "keywords": [
    "bibframe",
    "editor",
    "rdf"
  ],
  "version": "3.17.203",
  "homepage": "http://github.com/LD4P/sinopia_editor/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LD4P/sinopia_editor.git"
  },
  "engines": {
    "node": ">= 22.0.0"
  },
  "contributors": [
    "Kirk Hess <khes@loc.gov>",
    "Jeremy Nelson <jpnelson@stanford.edu>",
    "Joshua Greben",
    "Naomi Dushay",
    "Sarav Shah",
    "Johnathan Martin",
    "Michael Giarlo",
    "Justin Coyne",
    "Peter Mangiafico",
    "Justin Littman",
    "Aaron Collier",
    "Huda Khan"
  ],
  "bugs": {
    "url": "http://github.com/LD4P/sinopia_editor/issues"
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "webpack --progress --mode production",
    "dev-build": "webpack --progress --mode development",
    "dev-build-test": "npm run dev-build && npm run test",
    "dev-start": "webpack-dev-server --config ./webpack.config.js --mode development",
    "eslint": "eslint --color -c .eslintrc.js --ext js,jsx --max-warnings 0 .",
    "eslint-fix": "eslint --color -c .eslintrc.js --ext js,jsx --fix .",
    "eslint-fix-single": "eslint --color -c .eslintrc.js --fix",
    "pretty": "prettier --check .",
    "pretty-fix": "prettier --write .",
    "fix": "npm run pretty-fix && npm run eslint-fix",
    "lint": "npm run pretty && npm run eslint",
    "start": "npx babel-node server.js",
    "test": "jest --colors --silent --runInBand --logHeapUsage",
    "test-verbose": "jest --colors --runInBand",
    "cypress-verify": "cypress verify",
    "cypress-open": "cypress open",
    "cypress-run": "cypress run -b chrome --headless"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@aws-amplify/auth": "^4.3.5",
    "@fortawesome/fontawesome-svg-core": "^1.2.36",
    "@fortawesome/free-solid-svg-icons": "^5.15.4",
    "@fortawesome/react-fontawesome": "^0.1.15",
    "@honeybadger-io/react": "^2.0.0",
    "@popperjs/core": "^2.10.1",
    "@rdfjs/serializer-jsonld-ext": "^3.0.0",
    "@reach/dialog": "^0.16.2",
    "assert": "^2.0.0",
    "bootstrap": "^5.1.1",
    "buffer": "^6.0.3",
    "concat-stream": "^2.0.0",
    "cors": "^2.8.5",
    "crypto-browserify": "3.12.0",
    "crypto-js": "^4.1.1",
    "date-and-time": "^2.0.1",
    "dotenv": "^16.4.5",
    "edtf": "^3.1.0",
    "event-stream": "^4.0.1",
    "express": "^4.21.0",
    "express-http-proxy": "^1.6.3",
    "file-saver": "^2.0.5",
    "html-webpack-plugin": "^5.3.2",
    "identity-obj-proxy": "^3.0.0",
    "javascript-time-ago": "^2.3.9",
    "jsonld-streaming-parser": "^2.4.0",
    "language-subtag-registry": "^0.3.21",
    "lodash": "^4.17.21",
    "merge": "^2.1.1",
    "mixin-deep": ">=1.3.2",
    "n3": "^1.17.4",
    "nanoid": "^3.1.25",
    "process": "^0.11.10",
    "randexp": "^0.5.3",
    "rdf-ext": "^1.3.5",
    "react": "^17.0.2",
    "react-bootstrap-icons": "^1.5.0",
    "react-bootstrap-typeahead": "^5.2.0",
    "react-dom": "^17.0.2",
    "react-focus-lock": "^2.12.1",
    "react-helmet-async": "^1.1.2",
    "react-hot-loader": "^4.13.0",
    "react-multi-select-component": "^4.3.0",
    "react-offcanvas": "^0.4.0",
    "react-redux": "^7.2.5",
    "react-router-dom": "^5.3.0",
    "react-textarea-autosize": "8.4.0",
    "redux": "^4.1.1",
    "redux-thunk": "^2.3.0",
    "stream-browserify": "^3.0.0",
    "uuid": "^8.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/eslint-parser": "^7.25.0",
    "@babel/node": "^7.26.0",
    "@babel/plugin-transform-runtime": "^7.25.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.25.0",
    "@babel/runtime": "^7.26.0",
    "@testing-library/dom": "^9.3.4",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^12.1.5",
    "autoprefixer": "^10.4.20",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.2.1",
    "babel-plugin-module-resolver": "^5.0.2",
    "css-loader": "^7.1.2",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-webpack": "^0.13.9",
    "eslint-plugin-cypress": "^3.6.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.9.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-n": "^17.14.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-security": "^1.7.1",
    "eslint-plugin-testing-library": "^7.1.0",
    "fetch-mock-jest": "^1.5.1",
    "isomorphic-fetch": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-localstorage-mock": "^2.4.26",
    "jest-mock-console": "^2.0.0",
    "jest-prop-type-error": "^1.1.0",
    "jest-summarizing-reporter": "^1.1.4",
    "jsdom": "^25.0.1",
    "jsdom-global": "3.0.2",
    "postcss-loader": "^8.1.1",
    "prettier": "^3.4.2",
    "raw-loader": "^4.0.2",
    "redux-mock-store": "^1.5.4",
    "sass": "^1.81.0",
    "sass-loader": "^16.0.3",
    "style-loader": "^4.0.0",
    "timezone-mock": "^1.3.6",
    "webpack": "^5.96.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0"
  },
  "jest": {
    "automock": false,
    "resetMocks": false,
    "setupFilesAfterEnv": [
      "<rootDir>/react-testing-library.setup.js",
      "<rootDir>/__tests__/matchers/templates.js",
      "<rootDir>/__tests__/matchers/resources.js",
      "<rootDir>/__tests__/matchers/actions.js"
    ],
    "moduleDirectories": [
      "node_modules",
      "src",
      "__tests__/testUtilities"
    ],
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/__mocks__/fileMock.js",
      "\\.(css|scss|sass|less)$": "identity-obj-proxy"
    },
    "collectCoverageFrom": [
      "src/**/*.js",
      "src/**/*.jsx",
      "!src/index.js"
    ],
    "setupFiles": [
      "<rootDir>/jest.polyfills.js",
      "jest-localstorage-mock",
      "jest-prop-type-error",
      "dotenv/config"
    ],
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/__tests__/**/*.test.[jt]s?(x)"
    ],
    "transform": {
      "^.+\\.[jt]sx?$": "babel-jest"
    },
    "collectCoverage": true,
    "coverageReporters": [
      "lcov"
    ],
    "resolver": "<rootDir>/__tests__/testUtilities/resolver.js",
    "reporters": [
      [
        "jest-summarizing-reporter",
        {
          "diffs": true
        }
      ]
    ]
  },
  "optionalDependencies": {
    "cypress": "^13.17.0"
  },
  "overrides": {
    "@digitalbazaar/http-client": "^3.4.1"
  },
  "main": ".eslintrc.js",
  "author": ""
}
